root = true

[*]
end_of_line = crlf
charset = utf-8

[*.cs]
# Promover todas las sugerencias de analizadores y estilo a advertencias
dotnet_analyzer_diagnostic.severity = warning
dotnet_compiler_diagnostic.severity = warning


# Preferencia de no usar llaves en bloques de una sola línea (csharp-lint-user)
csharp_prefer_braces = false:warning

# Preferencia de tipos explícitos (evitando var)
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_for_declared_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning

# Forzar cuerpos de expresión (expression-bodied) en todos los casos posibles
csharp_style_expression_bodied_methods = true:warning
csharp_style_expression_bodied_constructors = true:warning
csharp_style_expression_bodied_operators = true:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_indexers = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = true:warning

# Reglas de alto rendimiento y AOT (csharp-lint-user)
csharp_style_prefer_range_operator = true:warning
csharp_style_prefer_index_operator = true:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

# Reglas de nomenclatura y excepciones de proyecto
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.IDE0065.severity = none

# Excepciones para suites de pruebas y benchmarks
[*.Tests/**.cs]
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1852.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0230.severity = none

[*.Benchmarks/**.cs]
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0230.severity = none
dotnet_diagnostic.CA1852.severity = none
